RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# Route translations.js and favicon.svg to directory listing root for any subfolder depth
RewriteRule (^|/)translations\.js$ translations.js [L]
RewriteRule (^|/)favicon\.svg$ favicon.svg [L]

Header always set Content-Security-Policy "upgrade-insecure-requests;"

# Character encoding
AddDefaultCharset UTF-8
AddCharset UTF-8 .html

# Enable directory listing
Options +Indexes
IndexOptions FancyIndexing VersionSort NameWidth=* DescriptionWidth=* SuppressRules SuppressHTMLPreamble HTMLTable Charset=UTF-8
HeaderName /header.html
ReadmeName /footer.html
IndexIgnore .htaccess header.html footer.html list.html tinyindex.html translations.js favicon.svg *.md .gemini .git
DirectoryIndex disabled

# Descriptions for folders and files (AddDescription "Description Text" filename_or_dirname/)
# Examples:
# AddDescription "Jigeen yi ak Yàlla" jay/
# AddDescription "Complete Wolof Audio Collection" acc.zip

# Treat .dic files as binary
AddType application/octet-stream dic

<FilesMatch "\.(mov|mp3|jpg|pdf|dic|txt)$">
    ForceType application/octet-stream
    Header set Content-Disposition attachment
</FilesMatch>
